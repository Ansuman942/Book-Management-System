        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var book = new GlideRecord('x_cdltd_book_manag_book_inventory'); // your inventory table
    if (book.get(current.book)) {
        
        // Decrease the stock
        book.quantity_in_stock -= current.quantity_sold;
        book.update();

        // Check if stock is low
        if (book.quantity_in_stock < book.reorder_level) {

            var alert = new GlideRecord('x_cdltd_book_manag_stock_alert'); // your stock alert table
            alert.initialize();
            alert.book = book.sys_id;
            alert.current_stock = book.quantity_in_stock;
            alert.alert_status = 'Triggered';
            alert.generated_on = new GlideDateTime();
            alert.insert();
        }
    }

})(current, previous);
]]></script>
